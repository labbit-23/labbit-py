[server]
base_url = http://120.138.8.37:9999
context = shivam

[api]
# Base used for DgWordoleVF filename resolver
radiology_wordole_base = http://120.138.8.37:9999/shivam
lookup_url = http://120.138.8.37:7777/clouduat/TApiQuery
terminalid = YOUR_TERMINAL_ID
webformid = wf269
lookup_direct = http://120.138.8.37:7777//clouduat/TApiQuery?webformid=wf275&terminalid=YOUR_TERMINAL_ID
reportstatusapi = http://120.138.8.37:7777//clouduat/TApiQuery?webformid=wf270&terminalid=YOUR_TERMINAL_ID
reportstatusreqidapi = http://120.138.8.37:7777//clouduat/TApiQuery?webformid=wf274&terminalid=YOUR_TERMINAL_ID
getrequisitionsbydateapi = http://120.138.8.37:7777//clouduat/TApiQuery?webformid=wf271&terminalid=YOUR_TERMINAL_ID
updatedeliverystatusapi = http://120.138.8.37:7777//clouduat/TApiQuery?webformid=wf272&terminalid=YOUR_TERMINAL_ID
getdeliverystatusapi = http://120.138.8.37:7777//clouduat/TApiQuery?webformid=wf273&terminalid=YOUR_TERMINAL_ID
getdemographicsbymrnoapi = http://120.138.8.37:7777//clouduat/TApiQuery?webformid=wfXXX&terminalid=YOUR_TERMINAL_ID
updatedemographicsapi = http://120.138.8.37:7777//clouduat/TApiQuery?webformid=wfYYY&terminalid=YOUR_TERMINAL_ID
getpricelistapi = http://120.138.8.37:7777//clouduat/TApiQuery?webformid=wfZZZ&terminalid=YOUR_TERMINAL_ID
getdepartmentlistapi = http://120.138.8.37:7777//clouduat/TApiQuery?webformid=wf282&terminalid=YOUR_TERMINAL_ID

[login]
username = admin
password = CHANGE_ME_OR_USE_ENV

[defaults]
reg = 0
version = 9.4.56
clienttype = Regular

[paths]
reports = reports
logs = logs
backgroundpath = assets/background.png

[trends]
url = http://120.138.8.37:9999/shivam/globalreport

[whatsapp]
send_reports_template = reports_pdf
whatsapp_api_key = CHANGE_ME_OR_USE_ENV
default_phone =
fallback_phone =
whatsapp_endpoint =

[departments]
dopplers = DPT00055
haematology = DPT00002
microbiology_serology = DPT00003
clinical_pathology = DPT00004
radiology = DPT00006
cyto_histopathology = DPT00013
general = DPT00032
special_tests = DPT00033
biochemistry = DPT00035
sonology = DPT00038
cardiology = DPT00049
ct_scan = DPT00050
hormones = DPT00052
bmd = DPT00053
infusions = DEP00056
physiotherapy = DEP00057



[dispatch_policy]
# Comma-separated SOURCEID values for which report dispatch/download should be denied
do_not_send_source_ids =


[outsourced]
# 1 => extract QR from attached PDF and fetch external letterhead
# 0 => skip QR fetch and use attached PDF directly
fetchreport_fromqr = 1
# overlay(default): SDRC background on top of page-1 content
# underlay: SDRC background behind page-1 content
# logo_only: place assets/logo.png at configured position on page 1
header_merge_mode = overlay
# logo placement (points). Use either width or height (or both; width wins).
logo_left_pt = 36
logo_top_pt = 20
logo_width_pt = 120
# logo_height_pt =


[radiology]
# 1 => resolve radiology filename via DgWordoleVF on :9999 first, then fetch PDF from wordimages
# 0 => keep legacy static wordimages fetch
use_wordole_resolver = 0
